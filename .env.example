# AttendSheets Environment Configuration

# Database (PostgreSQL 15 + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendsheets?schema=public"

# Cache / Nonces (Redis 7 - with in-memory fallback if unavailable)
REDIS_URL="redis://localhost:6379"

# Secrets (Minimum 32 characters)
JWT_SECRET="attendsheets-jwt-super-secret-key-at-least-32-chars-long"
QR_JWT_SECRET="attendsheets-qr-jwt-super-secret-key-32-chars-long"
CHECK_PASS_SECRET="attendsheets-checkpass-super-secret-key-32-chars"

# WebAuthn Configuration
RP_ID="localhost"
RP_NAME="AttendSheets"
RP_ORIGIN="http://localhost:3000"

# Application Base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
